# OpenAI-compatible Chat Completions: OpenRouter, OpenAI, or another endpoint.
# Use the API root, without /chat/completions. Keep the key server-side.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_API_KEY=
MODEL_CRITICAL=google/gemma-4-26b-a4b-it
MODEL_MAX_OUTPUT_TOKENS=32768

# Optional per-stage model overrides; otherwise stages use MODEL_CRITICAL.
# MODEL_FAST=
# MODEL_LAYOUT=
# MODEL_COMPARE=

# Direct OpenAI: set MODEL_BASE_URL=https://api.openai.com/v1,
# MODEL_API_KEY to your OpenAI key, and MODEL_CRITICAL to its vision model ID.
# Select a model that supports Chat Completions and the configured output limit.

# Native Gemini remains available: set MODEL_PROVIDER=gemini,
# MODEL_CRITICAL to a Gemini model ID, and configure one access method:
# GEMINI_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# USE_INTERACTIONS_API=false

DATABASE_URL=postgresql://dots:dots@localhost:5432/dots
UPLOADS_DIR=data/uploads

# Dots backend origin for the optional rendering/evaluation scripts.
# This is separate from the model provider's MODEL_BASE_URL.
API_URL=http://localhost:3003
